# Keep secrets and junk out of the Docker build context / images
.env
.env.*
.env.local
.hermes_env.sh

# Git & IDE
.git
.idea
.vscode

# Node / Next build artifacts (rebuilt inside the image)
node_modules
.next
package-lock.json.bak

# Python caches
__pycache__
*.pyc
.pytest_cache

# Runtime state & exports (regenerated at runtime)
exports
exports_*
scigraph_data
.scigraph_searches.json
*.sqlite
*.duckdb

# Isolated test copy & scratch
isolate
test_*

# Docs not needed in the image
*.md
LICENSE
